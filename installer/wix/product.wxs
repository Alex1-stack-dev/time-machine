<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <!-- Define product, package, and version info -->
    <Product Id="*" 
             Name="Time Machine" 
             Language="1033" 
             Version="!(bind.FileVersion.TimeMachineEXE)" 
             Manufacturer="Alex1-stack-dev" 
             UpgradeCode="12345678-1234-1234-1234-123456789012">
        
        <Package InstallerVersion="200" 
                 Compressed="yes" 
                 InstallScope="perUser"
                 Platform="x64"/>

        <MediaTemplate EmbedCab="yes"/>
        <MajorUpgrade DowngradeErrorMessage="A newer version is already installed."
                      AllowSameVersionUpgrades="yes"/>

        <!-- Application icon -->
        <Icon Id="icon.ico" SourceFile="assets\icon.ico"/>
        <Property Id="ARPPRODUCTICON" Value="icon.ico"/>

        <!-- Installation directory structure -->
        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="LocalAppDataFolder">
                <Directory Id="COMPANYFOLDER" Name="TimeMachine">
                    <Directory Id="INSTALLFOLDER" Name="bin"/>
                </Directory>
            </Directory>
            <!-- Start Menu shortcuts -->
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="Time Machine"/>
            </Directory>
        </Directory>

        <!-- Components to install -->
        <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
            <Component Id="MainExecutable" Guid="*">
                <File Id="TimeMachineEXE" 
                      Name="time-machine.exe"
                      Source="$(var.BinDir)\time-machine.exe"
                      KeyPath="yes"/>
                <!-- Shortcuts -->
                <Shortcut Id="StartMenuShortcut"
                          Directory="ApplicationProgramsFolder"
                          Name="Time Machine"
                          WorkingDirectory="INSTALLFOLDER"
                          Icon="icon.ico"
                          IconIndex="0"
                          Advertise="yes"/>
            </Component>
            <Component Id="UpdaterExecutable" Guid="*">
                <File Id="UpdaterEXE"
                      Name="time-machine-updater.exe"
                      Source="$(var.BinDir)\time-machine-updater.exe"
                      KeyPath="yes"/>
            </Component>
            <!-- Cleanup on uninstall -->
            <Component Id="CleanupShortcuts" Guid="*">
                <RemoveFolder Id="ApplicationProgramsFolder"
                             On="uninstall"/>
                <RegistryValue Root="HKCU"
                             Key="Software\TimeMachine"
                             Name="installed"
                             Type="integer"
                             Value="1"
                             KeyPath="yes"/>
            </Component>
        </ComponentGroup>

        <!-- Features to install -->
        <Feature Id="ProductFeature" Title="Time Machine" Level="1">
            <ComponentGroupRef Id="ProductComponents"/>
        </Feature>

        <!-- UI settings -->
        <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER"/>
        <UIRef Id="WixUI_InstallDir"/>
        <WixVariable Id="WixUILicenseRtf" Value="installer\wix\license.rtf"/>
        <WixVariable Id="WixUIBannerBmp" Value="installer\wix\banner.bmp"/>
        <WixVariable Id="WixUIDialogBmp" Value="installer\wix\dialog.bmp"/>
    </Product>
</Wix>
